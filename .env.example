# =============================================================================
# AgentReady — environment configuration
# Copy this file to .env and fill in values. Never commit .env.
# =============================================================================

# ---- Core service ----------------------------------------------------------
# Where the public dashboard expects the API. Used in CORS + Next.js.
PUBLIC_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# ---- Database --------------------------------------------------------------
# Postgres for state persistence. Override for production.
POSTGRES_URL=postgresql+asyncpg://agentready:agentready@localhost:5432/agentready

# ---- LLM endpoints ---------------------------------------------------------
# Three modes:
#   stub          — local heuristic, no network, no auth (default for early dev)
#   huggingface   — free HuggingFace Inference Providers (sponsor); needs HF_TOKEN
#   vllm          — self-hosted vLLM on AMD MI300X (the demo path)
JUDGE_MODE=stub

# HuggingFace Inference Providers (free, OpenAI-compatible). Sponsor.
# Get a free token at https://huggingface.co/settings/tokens (read access is enough).
HF_INFERENCE_URL=https://router.huggingface.co/v1
HF_JUDGE_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_RED_MODEL=Qwen/Qwen2.5-7B-Instruct

# vLLM mode — set when MI300X is up.
JUDGE_LLM_URL=http://localhost:8001/v1
JUDGE_LLM_MODEL=meta-llama/Llama-3.1-70B-Instruct
JUDGE_LLM_API_KEY=EMPTY
RED_LLM_URL=http://localhost:8002/v1
RED_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
RED_LLM_API_KEY=EMPTY

# ---- GitHub (auto-PR generation) -------------------------------------------
# Personal access token with `public_repo` scope at minimum.
GITHUB_TOKEN=
# The fork org/user we open PRs into during demos (avoids spamming upstream).
GITHUB_DEMO_FORK_OWNER=

# ---- HuggingFace (Judge LLM Space + LoRA adapter publishing) ---------------
HF_TOKEN=
HF_USERNAME=

# ---- AMD Developer Cloud ---------------------------------------------------
# Used by deploy scripts and ROCm health checks. Populated after MI300X spin-up.
AMD_CLOUD_INSTANCE_IP=
ROCM_VERSION=7.0

# ---- x402 paid tier --------------------------------------------------------
# Coinbase Developer Platform x402 facilitator. Defaults to Base mainnet.
X402_FACILITATOR_URL=https://x402.coinbase.com
X402_NETWORK=base
# The wallet we receive payments at (USDC).
X402_RECEIVING_ADDRESS=
X402_PRIVATE_KEY=  # Only used for the facilitator-less smoke test path

# ---- MindsDB (digital twin data layer, sponsor) ----------------------------
MINDSDB_URL=http://localhost:47334
MINDSDB_USER=mindsdb
MINDSDB_PASSWORD=mindsdb

# ---- Akash Network (backend deploy target, sponsor) ------------------------
AKASH_KEY_NAME=
AKASH_KEYRING_BACKEND=os
AKASH_NODE=https://rpc.akashnet.net:443

# ---- Observability ---------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ---- Runtime knobs ---------------------------------------------------------
# Concurrency for the Quality-at-Volume Agent.
QUALITY_PARALLELISM=500
# Max wall-clock seconds per ASI category before timeout.
ASI_TIMEOUT_SECONDS=120
# Cache scan results keyed by repo SHA + scan profile.
CACHE_DIR=./data/leaderboard_cache
# Set to "stub" to short-circuit non-headline ASI categories with precomputed scores.
SCAN_PROFILE=full  # full | demo | stub
